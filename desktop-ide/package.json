{
  "name": "agentic-ide-desktop",
  "productName": "vibeCode",
  "version": "0.1.0",
  "private": true,
  "description": "A standalone, language-agnostic desktop IDE with a Python agent backend.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "launch:electron": "wait-on http://127.0.0.1:5173/ && node scripts/launch-electron.cjs",
    "dev": "npm run build:main && concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:launch:electron\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "test:backend": "npm run build:main && node --test tests/backendClient.test.cjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^44.7.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
